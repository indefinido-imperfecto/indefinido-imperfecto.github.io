rules_version = '2';

// Firestore-Sicherheitsregeln für den Spanisch Past Tenses Trainer.
// Einspielen: Firebase Console -> Firestore Database -> Regeln -> Inhalt einfügen -> Veröffentlichen
// (oder per CLI: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_]{3,15}$');
    }

    function hasOnlyStatFields(data) {
      return data.keys().hasOnly(['username', 'xp', 'streak', 'lastPracticed', 'verbErrors', 'signalErrors']);
    }

    function hasValidStatTypes(data) {
      return data.xp is int && data.xp >= 0
          && data.streak is int && data.streak >= 0 && data.streak <= 3660
          && (!('lastPracticed' in data) || data.lastPracticed is string)
          && (!('verbErrors' in data) || data.verbErrors is map)
          && (!('signalErrors' in data) || data.signalErrors is map)
          && (!('username' in data) || isValidUsername(data.username));
    }

    // Nutzerprofile: Rangliste ist öffentlich lesbar, schreiben darf nur der Besitzer
    match /users/{uid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && hasOnlyStatFields(request.resource.data)
                    && hasValidStatTypes(request.resource.data);

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && hasOnlyStatFields(request.resource.data)
                    && hasValidStatTypes(request.resource.data)
                    // XP dürfen nicht sinken und pro Schreibvorgang nur begrenzt steigen
                    && request.resource.data.xp >= resource.data.xp
                    && request.resource.data.xp - resource.data.xp <= 1000
                    // Benutzername kann nach dem ersten Setzen nicht mehr geändert werden
                    && (!('username' in resource.data)
                        || request.resource.data.username == resource.data.username);

      // Eigenes Profil löschen (nötig für den Rollback einer fehlgeschlagenen Registrierung)
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Reservierte Benutzernamen (Kleinschreibung als Dokument-ID)
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
                    && isValidUsername(name)
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
